        "pfa"
      ]
    },
    {
      "id": "torrents",
      "folder": {
        "en": "Torrents",
        "ru": "Торренты"
      },
      "extensions": [
        "torrent"
      ]
    },
    {
      "id": "certificates",
      "folder": {
        "en": "Certificates and keys",
        "ru": "Сертификаты и ключи"
      },
      "sensitive": true,
      "extensions": [
        "pem",
        "crt",
        "cer",
        "der",
        "p12",
        "pfx",
        "key",
        "csr",
        "ovpn",
        "p7b",
        "ppk",
        "mobileconfig",
        "kdbx",
        "kdb",
        "asc",
        "gpg",
        "pgp",
        "jks",
        "keystore",
        "p8"
      ]
    },
    {
      "id": "other",
      "folder": {
        "en": "Other",
        "ru": "Прочее"
      },
      "extensions": []
    }
  ],
  "name_rules": [
    {
      "id": "finance",
      "enabled": true,
      "applies_to": [
        "documents",
        "spreadsheets",
        "images"
      ],
      "folder": {
        "en": "Documents/Finance",
        "ru": "Документы/Финансы"
      },
      "regex": "(?i)(^|[^a-zа-яё])(invoices?|receipts?|(bank|account|card)[ _-]?statements?|purchase[ _-]?orders?|contracts?|agreements?|сч[её]т(а|ов|у|е|ами|ах)?|квитанци[яиюе]й?|чек(и|а|ов|ам)?(?![ -]?лист)|выписк[аиуе]|акт(ы|а|ов|е)?|договор(ы|а|ов|у|е)?|оплат[аыуе]|плат[её]ж(и|а|ей|н[а-яё]*|к[а-яё]*)?|налог(и|а|ов|ов[а-яё]+)?|справк[аиуе])($|[^a-zа-яё])"
    },
    {
      "id": "private-key",
      "enabled": true,
      "applies_to": [
        "presentations",
        "other"
      ],
      "category": "certificates",
      "regex": "(?i)^(?=.*(?:^|[^a-z])(?:id_rsa|id_ed25519|id_ecdsa|id_dsa|privkey|private|secret|ssl|tls|cert)(?:[^a-z]|$))(?:[^.]+|.*\\.key)$"
    }
  ],
  "media_type_fallback": {
    "image": "images",
    "video": "videos",
    "audio": "audio",
    "compressed": "archives",
    "backup": "archives",
    "document": "documents",
    "text": "documents",
    "spreadsheet": "spreadsheets",
    "book": "books",
    "executable": "installers",
    "diskimage": "disk-images",
    "font": "fonts",
    "development": "code",
    "data": "code",
    "web": "code",
    "settings": "code",
    "encoded": "other",
    "flash": "other",
    "unknown": "other"
  },
  "ambiguous_extensions": {
    "_comment": "Extensions with two common meanings. When Yandex reports one of the listed media_type values, that category wins; otherwise the extension's default category applies.",
    "ts": {
      "video": "videos",
      "development": "code",
      "text": "code"
    },
    "img": {
      "image": "images",
      "diskimage": "disk-images"
    },
    "key": {
      "document": "presentations",
      "encoded": "certificates",
      "web": "certificates",
      "text": "certificates"
    }
  },
  "skip": {
    "_comment": "Files that must never be moved: partial downloads still being written, editor lock files, OS metadata.",
    "extensions": [
      "crdownload",
      "part",
      "partial",
      "download",
      "tmp",
      "temp",
      "aria2",
      "!qb",
      "!ut",
      "bc!",
      "opdownload",
      "dctmp",
      "td",
      "dtapart"
    ],
    "name_regex": [
      "^~\\$",
      "^\\.",
      "^desktop\\.ini$",
      "^thumbs\\.db$"
    ]
  },
  "special_folders": {
    "duplicates": {
      "en": "_Duplicates",
      "ru": "_Дубликаты"
    }
  }
}
