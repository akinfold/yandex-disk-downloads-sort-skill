{
  "version": 1,
  "_comment": "Default sorting rules. Copy this file, edit it, and pass --rules <file> to downloads_sort.py. Category ids are stable; folder names are per language. Extensions are lower-case without the dot; multi-part ones like tar.gz are matched before the last segment. Earlier categories win when a file matches several.",
  "categories": [
    {
      "id": "screenshots",
      "folder": {
        "en": "Screenshots",
        "ru": "Скриншоты"
      },
      "requires_extensions_of": "images",
      "name_regex": [
        "^(screen ?shot|screencapture|screen capture|cleanshot|снимок экрана|скриншот|bildschirmfoto|capture d.écran|captura de pantalla)[ _\\-(]",
        "^screenshot_?\\d",
        "^(снимок экрана|screenshot|screen shot) \\d{4}-\\d{2}-\\d{2}",
        "^(снимок экрана|screenshot) \\(\\d+\\)"
      ]
    },
    {
      "id": "images",
      "folder": {
        "en": "Images",
        "ru": "Изображения"
      },
      "extensions": [
        "jpg",
        "jpeg",
        "jpe",
        "png",
        "gif",
        "bmp",
        "tif",
        "tiff",
        "webp",
        "heic",
        "heif",
        "avif",
        "svg",
        "ico",
        "psd",
        "ai",
        "eps",
        "raw",
        "cr2",
        "cr3",
        "nef",
        "arw",
        "dng",
        "orf",
        "rw2",
        "raf",
        "sketch",
        "fig",
        "xcf"
      ]
    },
    {
      "id": "documents",
      "folder": {
        "en": "Documents",
        "ru": "Документы"
      },
      "extensions": [
        "pdf",
        "doc",
        "docx",
        "docm",
        "dot",
        "dotx",
        "odt",
        "rtf",
        "txt",
        "md",
        "markdown",
        "pages",
        "tex",
        "wpd",
        "xps",
        "oxps",
        "eml",
        "msg",
        "vcf",
        "ics"
      ]
    },
    {
      "id": "spreadsheets",
      "folder": {
        "en": "Spreadsheets",
        "ru": "Таблицы"
      },
      "extensions": [
        "xls",
        "xlsx",
        "xlsm",
        "xlsb",
        "ods",
        "csv",
        "tsv",
        "numbers"
      ]
    },
    {
      "id": "presentations",
      "folder": {
        "en": "Presentations",
        "ru": "Презентации"
      },
      "extensions": [
        "ppt",
        "pptx",
        "pps",
        "ppsx",
        "pptm",
        "odp",
        "key"
      ]
    },
    {
      "id": "books",
      "folder": {
        "en": "Books",
        "ru": "Книги"
      },
      "extensions": [
        "epub",
        "mobi",
        "azw",
        "azw3",
        "kf8",
        "fb2",
        "fb2.zip",
        "djvu",
        "djv",
        "cbz",
        "cbr",
        "ibooks"
      ]
    },
    {
      "id": "videos",
      "folder": {
        "en": "Videos",
        "ru": "Видео"
      },
      "extensions": [
        "mp4",
        "m4v",
        "mkv",
        "mov",
        "avi",
        "wmv",
        "flv",
        "webm",
        "mpg",
        "mpeg",
        "mpe",
        "ts",
        "m2ts",
        "mts",
        "3gp",
        "3g2",
        "vob",
        "ogv"
      ]
    },
    {
      "id": "audio",
      "folder": {
        "en": "Audio",
        "ru": "Аудио"
      },
      "extensions": [
        "mp3",
        "wav",
        "flac",
        "m4a",
        "aac",
        "ogg",
        "oga",
        "opus",
        "wma",
