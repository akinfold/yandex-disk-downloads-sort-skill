        "ova",
        "ovf",
        "qcow2",
        "dsk",
        "toast",
        "cue"
      ]
    },
    {
      "id": "code",
      "folder": {
        "en": "Code and data",
        "ru": "Код и данные"
      },
      "extensions": [
        "py",
        "ipynb",
        "js",
        "mjs",
